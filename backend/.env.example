# Server Configuration
PORT=7000                              # Port on which the server will run
NODE_ENV=development                   # Environment mode (development/production/test)
APP_VERSION=1.0.0                      # Application version used in API responses

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/boosty  # MongoDB connection string

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here    # Secret key for JWT token generation (change in production)
JWT_EXPIRE=7d                          # JWT token expiration time (e.g., 7d, 24h, 60m)

# Email Configuration (if using nodemailer)
EMAIL_HOST=smtp.gmail.com              # SMTP server host
EMAIL_PORT=587                         # SMTP server port
EMAIL_USER=your_email@gmail.com        # SMTP username for sending emails
EMAIL_PASS=your_email_password         # SMTP password for sending emails

# API Configuration
API_URL=http://localhost:7000          # Base URL for API testing scripts

# Other Configuration
CORS_ORIGIN=http://localhost:3000      # Allowed CORS origins (comma-separated for multiple)

# Queue Configuration
REDIS_HOST=localhost                  # Redis server host
REDIS_PORT=6379                       # Redis server port
REDIS_PASSWORD=                        # Redis server password (if required)
REDIS_DB=0                           # Redis database number

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid    # Twilio Account SID
TWILIO_AUTH_TOKEN=your_twilio_auth_token      # Twilio Auth Token
TWILIO_FROM_NUMBER=+1234567890             # Twilio phone number for sending SMS
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid  # Optional: Twilio Messaging Service SID

# Twilio Rate Limiting
TWILIO_RATE_LIMIT_PER_SECOND=1          # Max SMS per second
TWILIO_RATE_LIMIT_PER_MINUTE=60         # Max SMS per minute
TWILIO_RATE_LIMIT_PER_HOUR=1000         # Max SMS per hour
TWILIO_RATE_LIMIT_PER_DAY=10000         # Max SMS per day

# Mailgun Configuration
MAILGUN_API_KEY=your_mailgun_api_key      # Mailgun API key
MAILGUN_DOMAIN=your_domain.com            # Mailgun domain
MAILGUN_REGION=us                        # Mailgun region (us/eu)
MAILGUN_PUBLIC_KEY=your_mailgun_public_key # Mailgun public key
MAILGUN_DEFAULT_FROM=noreply@your_domain.com # Default from email address
MAILGUN_DEFAULT_REPLY_TO=support@your_domain.com # Default reply-to email address

# Mailgun Rate Limiting
MAILGUN_RATE_LIMIT_PER_SECOND=5          # Max emails per second
MAILGUN_RATE_LIMIT_PER_MINUTE=300         # Max emails per minute
MAILGUN_RATE_LIMIT_PER_HOUR=10000         # Max emails per hour
MAILGUN_RATE_LIMIT_PER_DAY=50000         # Max emails per day

# Mailgun Content Configuration
MAILGUN_BLOCKED_WORDS=spam,scam,fraud     # Blocked words in email content
MAILGUN_ALLOWED_DOMAINS=boosty.com,example.com  # Allowed domains in links

# Mailgun Webhook Configuration
MAILGUN_WEBHOOK_SIGNING_KEY=your_webhook_signing_key  # Key for webhook validation
MAILGUN_WEBHOOK_ALLOWED_IPS=              # Comma-separated list of allowed IP addresses

# Mailgun Monitoring Configuration
MAILGUN_MONITORING_ENABLED=true           # Enable monitoring
MAILGUN_LOGGING_ENABLED=true              # Enable logging
MAILGUN_LOG_LEVEL=info                   # Log level (debug, info, warn, error)
MAILGUN_LOG_REQUEST_BODY=false            # Include request body in logs
MAILGUN_LOG_RESPONSE_BODY=false           # Include response body in logs
MAILGUN_MOCK_DELIVERY=false              # Mock delivery for testing

# Mailgun Report Configuration
MAILGUN_REPORT_RECIPIENTS=admin@boosty.com  # Report recipients (comma-separated)

# Twilio Regional Configuration
TWILIO_DEFAULT_COUNTRY_CODE=US           # Default country code for phone numbers
TWILIO_SUPPORTED_COUNTRIES=US,CA,GB,AU,NG,KE,ZA,GH,UG,TZ  # Supported country codes
TWILIO_RESTRICTED_COUNTRIES=CU,IR,KP,SY  # Restricted country codes
TWILIO_DEFAULT_TIMEZONE=UTC              # Default timezone
TWILIO_QUIET_HOURS_ENABLED=false          # Enable quiet hours
TWILIO_QUIET_HOURS_START=22:00          # Quiet hours start time
TWILIO_QUIET_HOURS_END=08:00            # Quiet hours end time
TWILIO_QUIET_HOURS_TIMEZONE=UTC         # Quiet hours timezone

# Twilio Content Configuration
TWILIO_BLOCKED_WORDS=spam,scam,fraud     # Blocked words in SMS content
TWILIO_ALLOWED_DOMAINS=boosty.com,example.com  # Allowed domains in links
TWILIO_MAX_MESSAGE_LENGTH=1600           # Maximum message length

# Twilio Webhook Configuration
TWILIO_WEBHOOK_AUTH_TOKEN=your_webhook_auth_token  # Token for webhook validation
TWILIO_WEBHOOK_ALLOWED_IPS=              # Comma-separated list of allowed IP addresses

# Twilio Monitoring Configuration
TWILIO_MONITORING_ENABLED=true           # Enable monitoring
TWILIO_LOGGING_ENABLED=true              # Enable logging
TWILIO_LOG_LEVEL=info                   # Log level (debug, info, warn, error)
TWILIO_LOG_REQUEST_BODY=false            # Include request body in logs
TWILIO_LOG_RESPONSE_BODY=false           # Include response body in logs
TWILIO_MOCK_DELIVERY=false              # Mock delivery for testing

# Twilio Report Configuration
TWILIO_REPORT_RECIPIENTS=admin@boosty.com  # Report recipients (comma-separated)

# Company Information
COMPANY_NAME=Boosty                     # Company name for templates
SUPPORT_PHONE=+1234567890               # Support phone number
SUPPORT_EMAIL=support@boosty.com          # Support email address

# Error Notification Configuration
ERROR_NOTIFICATION_RECIPIENTS=admin@boosty.com  # Error notification recipients (comma-separated)