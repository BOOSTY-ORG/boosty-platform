								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transactionId\": \"TXN_{{timestamp}}_{{$randomUUID}}\",\n  \"amount\": 1000000,\n  \"email\": \"customer@example.com\",\n  \"paymentMethod\": \"card\",\n  \"currency\": \"NGN\",\n  \"transactionType\": \"investment\",\n  \"callbackUrl\": \"{{callback_url}}\",\n  \"metadata\": {\n    \"userId\": \"{{user_id}}\",\n    \"investmentId\": \"{{investment_id}}\"\n  },\n  \"split\": {\n    \"type\": \"percentage\",\n    \"bearer\": \"account\",\n    \"subaccounts\": [\n      {\n        \"subaccount\": \"ACCT_abc123\",\n        \"share\": 80\n      },\n      {\n        \"subaccount\": \"ACCT_def456\",\n        \"share\": 20\n      }\n    ]\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/payments/initialize",
							"host": ["{{base_url}}"],
							"path": ["api", "payments", "initialize"]
