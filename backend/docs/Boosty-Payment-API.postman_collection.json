				"type": "text/javascript",
				"exec": [
					"// Auto-generate timestamp for unique transaction IDs",
					"pm.environment.set(\"timestamp\", Date.now());",
					"",
					"// Generate random UUID for testing",
					"pm.environment.set(\"randomUUID\", require('crypto').randomUUID());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Test script to validate response",
					"if (pm.response.code >= 200 && pm.response.code < 300) {",
					"    pm.test(\"Status code is \" + pm.response.code + \"\", true);",
					"} else {",
					"    pm.test(\"Status code is \" + pm.response.code + \"\", false);",
					"}",
					"",
					"// Test for success field in response",
					"if (pm.response.json().success === true) {",
					"    pm.test(\"Response has success field\", true);",
					"} else {",
					"    pm.test(\"Response has success field\", false);",
					"}"
				]
			}
		}
